# =============================================================================
# OneXDeal — Root Environment Configuration Example (Development)
# Copy to .env (`cp .env.example .env`) for local Docker Compose usage.
# NEVER commit real secrets, API keys, or production credentials.
# =============================================================================

NODE_ENV=development

# --- PostgreSQL 18 + PostGIS 3.7 (Local Docker Compose) ---
POSTGRES_USER=onexdeal
POSTGRES_PASSWORD=onexdeal_dev_password
POSTGRES_DB=onexdeal_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://onexdeal:onexdeal_dev_password@localhost:5432/onexdeal_dev

# --- Redis 7 (BullMQ, Rate Limiting & Future Socket.IO Scaling) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Local Transactional Email Testing (Mailpit) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Local S3/R2-Compatible Object Storage (MinIO) ---
MINIO_ROOT_USER=onexdeal_minio
MINIO_ROOT_PASSWORD=onexdeal_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
