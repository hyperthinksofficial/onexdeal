# =============================================================================
# OneXDeal Web (`apps/web`) — Environment Configuration Example
# Copy to `apps/web/.env.local` for local development.
# NEVER put private secrets in NEXT_PUBLIC_* variables.
# =============================================================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALITY=Hosur
NEXT_PUBLIC_DEFAULT_RADIUS_KM=10

# --- Public Google OAuth Client ID (Safe for client sign-in button) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Sentry Public DSN (PII scrubbing enforced before send) ---
NEXT_PUBLIC_SENTRY_DSN=
