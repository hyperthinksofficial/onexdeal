# =============================================================================
# OneXDeal Mobile (`apps/mobile`) — Environment Configuration Example
# Copy to `apps/mobile/.env` for local development.
# NEVER embed private API keys, OAuth client secrets, or DB URLs in EXPO_PUBLIC_*.
# =============================================================================

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000/realtime
EXPO_PUBLIC_DEFAULT_LOCALITY=Hosur
EXPO_PUBLIC_DEFAULT_RADIUS_KM=10

# --- Public Google OAuth Client IDs (Safe for client sign-in button) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# --- Sentry Public DSN (PII scrubbing enforced before send) ---
EXPO_PUBLIC_SENTRY_DSN=
