# =============================================================================
# OneXDeal API (`apps/api`) — Environment Configuration Example
# Copy to `apps/api/.env` for local development.
# NEVER commit real secrets or production credentials.
# =============================================================================

NODE_ENV=development
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- PostgreSQL 18 + PostGIS 3.7 (Drizzle ORM) ---
DATABASE_URL=postgresql://onexdeal:onexdeal_dev_password@localhost:5432/onexdeal_dev

# --- Redis 7 (BullMQ, Rate Limiting & Future Socket.IO Scaling) ---
REDIS_URL=redis://localhost:6379
SOCKET_IO_ADAPTER=memory

# --- Authentication Placeholders (Phase 1+) ---
# MVP supports ONLY Google OAuth 2.0 and Email + Password with email verification.
# SMS OTP and WhatsApp OTP are NOT part of MVP.
JWT_ACCESS_SECRET=replace_with_32_byte_min_random_dev_secret_key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Object Storage Placeholders (Cloudflare R2 / Local MinIO) ---
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=onexdeal-media-dev
STORAGE_ACCESS_KEY_ID=onexdeal_minio
STORAGE_SECRET_ACCESS_KEY=onexdeal_minio_secret
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/onexdeal-media-dev

# --- Transactional Email Placeholders (Mailpit in Local Dev) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@onexdeal.local

# --- Push Notification Placeholders (Expo Push Service) ---
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# --- Error Monitoring Placeholders (Sentry with PII Scrubbing) ---
SENTRY_DSN=
